# Agent credentials. Copy to ~/.config/heart-agents/default.env (shared by
# every agent, and by the app repo's agents) — NEVER into a repo; checkouts
# are mounted into containers wholesale. A <agent-name>.env beside it
# overrides default.env for that agent, if a token ever needs a smaller
# blast radius.

# Anthropic auth — generate on the host with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub fine-grained PAT scoped to heart-api (+ heart) only:
#   Contents: Read · Issues: Read and write · Metadata: Read
# Read-only Contents is deliberate — agents never push, so the token can't either.
GH_TOKEN=

# Sentry org auth token: project:read, event:read, issue:read
SENTRY_AUTH_TOKEN=

# AWS — only for agents launched with --aws. No secret lives here: the
# launcher assumes this dev-account role with your own profile and injects
# short-lived session creds into the container. The role is
# infrastructure/global/environments/dev/agent.tf (ReadOnlyAccess, dev only).
AGENT_AWS_ROLE_ARN=arn:aws:iam::583168578067:role/heart-agent
# AGENT_AWS_PROFILE=heart-dev
# AGENT_AWS_DURATION=14400
