{
  "$comment": "Heart's design tokens, the one source of truth. Edit here, then `make design` regenerates lib/src/presets.g.dart and site/assets/tokens.css. Colors are #RRGGBB; radii are logical pixels.",
  "default": "ink",
  "radii": {
    "control": 8,
    "card": 12
  },
  "faces": {
    "Onest": "sans-serif",
    "Unbounded": "sans-serif",
    "IBM Plex Sans": "sans-serif",
    "Literata": "serif",
    "Golos Text": "sans-serif",
    "Rubik": "sans-serif"
  },
  "presets": {
    "forge": {
      "note": "Dark-first: volt on green-black. Unbounded runs much wider than a text face, so the page title trades size for presence.",
      "fonts": {
        "text": "Onest",
        "title": "Onest",
        "display": "Unbounded"
      },
      "headline": {
        "size": 26,
        "weight": 700
      },
      "light": {
        "ground": "#FFFFFF",
        "surface": "#FFFFFF",
        "fill": "#F2F3E8",
        "ink": "#14160D",
        "muted": "#5B6055",
        "faint": "#969B8C",
        "border": "#DEE1D0",
        "accent": "#D4F547",
        "onAccent": "#121408",
        "accentInk": "#55650F",
        "destructive": "#B23A28"
      },
      "dark": {
        "ground": "#0F100D",
        "surface": "#191B15",
        "fill": "#232720",
        "ink": "#F1F2E9",
        "muted": "#9BA092",
        "faint": "#6F746A",
        "border": "#2A2D24",
        "accent": "#D4F547",
        "onAccent": "#121408",
        "accentInk": "#D4F547",
        "destructive": "#FF6B57"
      }
    },
    "ink": {
      "note": "Paper and ink with a cobalt accent, light-first the way Forge is dark-first. Warm neutrals, no green undertone; cobalt rather than vermilion, so the accent can never be confused with destructive. The house style.",
      "fonts": {
        "text": "IBM Plex Sans",
        "title": "Literata",
        "display": "Literata"
      },
      "headline": {
        "size": 30,
        "weight": 600
      },
      "light": {
        "ground": "#FFFFFF",
        "surface": "#FFFFFF",
        "fill": "#F4F1EA",
        "ink": "#1A1815",
        "muted": "#5D584E",
        "faint": "#948F85",
        "border": "#E2DED4",
        "accent": "#1F4EC8",
        "onAccent": "#FFFFFF",
        "accentInk": "#1B43A8",
        "destructive": "#9E2B25"
      },
      "dark": {
        "ground": "#141311",
        "surface": "#1E1C19",
        "fill": "#2A2721",
        "ink": "#F2F0EA",
        "muted": "#A29D93",
        "faint": "#6F6B63",
        "border": "#302D27",
        "accent": "#93ADFF",
        "onAccent": "#0F1526",
        "accentInk": "#93ADFF",
        "destructive": "#FF7A66"
      }
    },
    "utility": {
      "note": "The calm tool: cool neutrals where Forge is green-black and Ink is warm paper, forest green for the accent, nothing raised above its station. One family carrying everything is the point.",
      "fonts": {
        "text": "Golos Text",
        "title": "Golos Text",
        "display": "Golos Text"
      },
      "headline": {
        "size": 28,
        "weight": 700
      },
      "light": {
        "ground": "#FFFFFF",
        "surface": "#FFFFFF",
        "fill": "#F2F4F5",
        "ink": "#16181D",
        "muted": "#575D66",
        "faint": "#949AA4",
        "border": "#E1E4E8",
        "accent": "#2F7A5F",
        "onAccent": "#FFFFFF",
        "accentInk": "#27664E",
        "destructive": "#C03A2E"
      },
      "dark": {
        "ground": "#101214",
        "surface": "#1A1D21",
        "fill": "#252A2F",
        "ink": "#ECEEF0",
        "muted": "#9AA1AB",
        "faint": "#6A7078",
        "border": "#2C3138",
        "accent": "#64C79B",
        "onAccent": "#0E1F18",
        "accentInk": "#64C79B",
        "destructive": "#FF7365"
      }
    },
    "ember": {
      "note": "Heat: true orange on warm neutrals, amber glow in the dark. The accentInk is burnt deep enough to read on white, and destructive stays crimson so orange can never be mistaken for danger.",
      "fonts": {
        "text": "Rubik",
        "title": "Rubik",
        "display": "Rubik"
      },
      "headline": {
        "size": 28,
        "weight": 700
      },
      "light": {
        "ground": "#FFFFFF",
        "surface": "#FFFFFF",
        "fill": "#F7F2EA",
        "ink": "#191510",
        "muted": "#5F584D",
        "faint": "#99917F",
        "border": "#E8E0D2",
        "accent": "#F07514",
        "onAccent": "#1F1206",
        "accentInk": "#9A4A00",
        "destructive": "#B3261E"
      },
      "dark": {
        "ground": "#14100C",
        "surface": "#1F1913",
        "fill": "#2B241C",
        "ink": "#F4EFE6",
        "muted": "#A69C8C",
        "faint": "#746A5C",
        "border": "#332B21",
        "accent": "#FF9E3D",
        "onAccent": "#211204",
        "accentInk": "#FF9E3D",
        "destructive": "#FF7361"
      }
    }
  }
}
