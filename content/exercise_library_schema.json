{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/exercises-master.2026-02-07.schema.json",
  "title": "Exercise Library Master File",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "locales",
    "fallback_to_default",
    "exercises"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Schema/content version identifier."
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(_[A-Z]{2})?$"
      },
      "description": "Locale codes like en, en_CA, ru."
    },
    "fallback_to_default": {
      "type": "string",
      "pattern": "^[a-z]{2}(_[A-Z]{2})?$",
      "description": "Default read-only fallback locale used when a requested locale entry is missing or incomplete and no per-entry fallback_to is set."
    },
    "exercises": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/exercise"
      },
      "description": "Map: exerciseId -> exercise definition."
    }
  },
  "$defs": {
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "target",
        "i18n"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "Weighted Body Weight",
            "Assisted Body Weight",
            "Reps Only",
            "Cardio",
            "Duration",
            "Machine",
            "Dumbbell",
            "Barbell"
          ],
          "minLength": 1
        },
        "target": {
          "type": "string",
          "enum": [
            "Core",
            "Arms",
            "Back",
            "Chest",
            "Legs",
            "Shoulders",
            "Other",
            "Olympic",
            "Full Body",
            "Cardio"
          ],
          "minLength": 1
        },
        "media": {
          "$ref": "#/$defs/media"
        },
        "muscles": {
          "$ref": "#/$defs/muscles"
        },
        "i18n": {
          "$ref": "#/$defs/i18nMap"
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "$ref": "#/$defs/assetPath"
            },
            "finish": {
              "$ref": "#/$defs/assetPath"
            }
          }
        }
      }
    },
    "muscles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/muscleRole"
        },
        "secondary": {
          "$ref": "#/$defs/muscleRole"
        }
      },
      "description": "Exercise muscle tagging split into primary and secondary involvement."
    },
    "muscleRole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "$ref": "#/$defs/muscleGroupList"
        },
        "ids": {
          "$ref": "#/$defs/muscleList"
        }
      }
    },
    "muscleGroupList": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "adductors",
          "arms",
          "back",
          "chest",
          "core",
          "glutes",
          "hamstrings",
          "legs",
          "neck",
          "shoulders"
        ]
      },
      "uniqueItems": true
    },
    "muscleList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "semimembranosus_2_r",
          "semimembranosus_2_l",
          "semimembranosus_1_r",
          "semimembranosus_1_l",
          "semitendinosus_r",
          "semitendinosus_l",
          "biceps_femoris_r",
          "biceps_femoris_l",
          "iliotibial_tract_r",
          "iliotibial_tract_l",
          "gastrocnemius_r",
          "gastrocnemius_l",
          "tibialis_anterior_l",
          "tibialis_anterior_r",
          "extensor_hallucis_longus_l",
          "extensor_hallucis_longus_r",
          "fibularis_longus_l",
          "fibularis_longus_r",
          "extensor_digitorum_longus_l",
          "extensor_digitorum_longus_r",
          "vastus_lateralis_l",
          "vastus_lateralis_r",
          "vastus_medialis_l",
          "vastus_medialis_r",
          "sartoris_l",
          "sartoris_r",
          "gracilis_l",
          "gracilis_r",
          "rectus_femoris_l",
          "rectus_femoris_r",
          "gluteus_maximus_r",
          "gluteus_maximus_l",
          "gluteus_medius_2_r",
          "gluteus_medius_2_l",
          "gluteus_medius_1_r",
          "gluteus_medius_1_l",
          "external_oblique_r",
          "external_oblique_l",
          "external_oblique_1_l",
          "external_oblique_1_r",
          "external_oblique_2_l",
          "external_oblique_2_r",
          "external_oblique_3_l",
          "external_oblique_3_r",
          "external_oblique_4_l",
          "external_oblique_4_r",
          "external_oblique_5_l",
          "external_oblique_5_r",
          "external_oblique_6_l",
          "external_oblique_6_r",
          "external_oblique_7_l",
          "external_oblique_7_r",
          "external_oblique_8_l",
          "external_oblique_8_r",
          "rectus_abdominis_1",
          "rectus_abdominis_2_l",
          "rectus_abdominis_2_r",
          "rectus_abdominis_3_l",
          "rectus_abdominis_3_r",
          "rectus_abdominis_4_l",
          "rectus_abdominis_4_r",
          "extensor_digitorum_r",
          "extensor_digitorum_l",
          "brachioradialis_r",
          "brachioradialis_l",
          "extensor_carpi_ulnaris_r",
          "extensor_carpi_ulnaris_l",
          "anconeus_r",
          "anconeus_l",
          "flexor_carpi_ulnaris_r",
          "flexor_carpi_ulnaris_l",
          "triceps_brachii_caput_laterale_r",
          "triceps_brachii_caput_laterale_l",
          "triceps_brachii_caput_longum_r",
          "triceps_brachii_caput_longum_l",
          "triceps_brachii_caput_mediale_r",
          "triceps_brachii_caput_mediale_l",
          "flexor_digitorum_superficialis_l",
          "flexor_digitorum_superficialis_r",
          "pronator_quadratus_l",
          "pronator_quadratus_r",
          "extensor_carpi_radialis_longus_l",
          "extensor_carpi_radialis_longus_r",
          "palmaris_longus_l",
          "palmaris_longus_r",
          "flexor_carpi_radialis_l",
          "flexor_carpi_radialis_r",
          "pronator_teres_l",
          "pronator_teres_r",
          "biceps_brachii_caput_breve_l",
          "biceps_brachii_caput_breve_r",
          "biceps_brachii_caput_longum_l",
          "biceps_brachii_caput_longum_r",
          "sternocleidomastoid_r",
          "sternocleidomastoid_l",
          "platysma",
          "sternohyoid",
          "infraspinatus_r",
          "infraspinatus_l",
          "latissimus_dorsi_r",
          "latissimus_dorsi_l",
          "lateral_deltoid_r",
          "lateral_deltoid_l",
          "posterior_deltoid_r",
          "posterior_deltoid_l",
          "trapezius_upper_r",
          "trapezius_upper_l",
          "trapezius_middle_r",
          "trapezius_middle_l",
          "trapezius_lower_r",
          "trapezius_lower_l",
          "anterior_deltoid_l",
          "anterior_deltoid_r",
          "pectoralis_major_l",
          "pectoralis_major_r",
          "adductor_magnus_l",
          "adductor_magnus_r",
          "adductor_longus_l",
          "adductor_longus_r",
          "pectineus_l",
          "pectineus_r"
        ]
      },
      "uniqueItems": true
    },
    "assetPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(assets/|asset://).+",
      "description": "Relative path (assets/...) or custom scheme (asset://...)."
    },
    "i18nMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/i18nEntry"
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2}(_[A-Z]{2})?$"
      },
      "description": "Per-locale content. Keys should be locale codes."
    },
    "i18nEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Exercise name in the current locale.",
          "maxLength": 200
        },
        "instructions": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000,
          "description": "Markdown content; may include images, e.g. ![](assets/...)."
        },
        "fallback_to": {
          "type": "string",
          "pattern": "^[a-z]{2}(_[A-Z]{2})?$",
          "description": "If a field is missing in this locale entry, read it from this locale for the same exercise (read-only fallback). Example: en_CA -> en."
        },
        "validated": {
          "type": "boolean",
          "default": false,
          "description": "If true, this locale entry has been validated by a human."
        }
      }
    }
  }
}